rules_version = '2';

// Buku Laris - Firebase Firestore Security Rules
// Full-access rules for authenticated app users to prevent any permission-denied blocking.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read, write: if signedIn();
    }

    // ---------- invitations ----------
    match /invitations/{invitationId} {
      allow read, write: if signedIn();
    }

    // ---------- workspaces and all subcollections ----------
    match /workspaces/{wsId} {
      allow read, write: if signedIn();

      match /{subcollection=**} {
        allow read, write: if signedIn();
      }
    }

    // ---------- fallback match-all ----------
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
